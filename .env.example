# Talkbalt API, used only by the Next.js server (app/api/backend); the browser never calls it directly.
TALKBALT_API_URL=http://localhost:8001

# Public website address for canonical URLs, sitemap.xml and robots.txt (e.g. https://talkbalt.com)
NEXT_PUBLIC_SITE_URL=
# Public contact for privacy requests, shown on /privacy (e.g. privacy@yourdomain.com)
NEXT_PUBLIC_CONTACT_EMAIL=
